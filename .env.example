# --- Joueurs suivis -----------------------------------------------------------
# Pseudos Discord à conseiller automatiquement, séparés par des virgules.
# Laisser vide pour n'utiliser que l'interface web.
ZU_USERS=

# Mode de jeu : NORMAL ou HARDCORE
RULESET=NORMAL

# Fréquence des conseils automatiques (cron, fuseau TZ).
CRON=*/30 * * * *
TZ=Europe/Paris

# --- Notifications (facultatif) ----------------------------------------------
# Webhook Discord : les conseils sont envoyés seulement quand le plan change.
WEBHOOK_URL=
# Mentionner le joueur (@pseudo) dans le message Discord.
DISCORD_MENTION=false
# Webhook générique : reçoit le plan complet en JSON (intégrations maison).
JSON_WEBHOOK_URL=
# URL publique de l'interface, pour les liens dans Discord (ex : https://ninja.example.com).
WEB_URL=

# --- Planificateur (facultatif) ------------------------------------------------
# BEAM_WIDTH=16
# BRANCHING=6
# Exemplaires gardés en plus pour les échanges.
# KEEP_EXTRA=0

# --- Avancé ---------------------------------------------------------------------
# PORT=8080
# DRY_RUN=false
# RUN_ON_START=true
# CATALOG_TTL_MINUTES=10
# LOG_LEVEL=info
