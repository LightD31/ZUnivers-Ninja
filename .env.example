# --- Joueurs suivis -----------------------------------------------------------
# Pseudos Discord à conseiller automatiquement, séparés par des virgules.
# Laisser vide pour n'utiliser que l'interface web.
# Ajoute « :stratégie » pour choisir la stratégie d'un joueur : alice:prudent,bob
ZU_USERS=

# Mode de jeu : NORMAL ou HARDCORE
RULESET=NORMAL

# Fréquence des conseils automatiques (cron, fuseau TZ).
CRON=*/30 * * * *
TZ=Europe/Paris

# --- Notifications (facultatif) ----------------------------------------------
# Webhook Discord : les conseils sont envoyés seulement quand le plan change.
WEBHOOK_URL=
# Mentionner le joueur (@pseudo) dans le message Discord.
DISCORD_MENTION=false
# Webhook générique : reçoit le plan complet en JSON (intégrations maison).
JSON_WEBHOOK_URL=
# URL publique de l'interface, pour les liens dans Discord (ex : https://ninja.example.com).
WEB_URL=

# --- Planificateur (facultatif) ------------------------------------------------
# Stratégie par défaut : equilibre, prudent, epargne, vortex ou collectionneur.
# STRATEGY=equilibre
# BEAM_WIDTH=8
# BRANCHING=4
# Exemplaires gardés en plus pour les échanges.
# KEEP_EXTRA=0
# Garde les exemplaires normaux à enchanter pour la constellation dorée (false :
# seuls ceux que le plan du jour enchante sont gardés).
# KEEP_FOR_GOLDEN=true
# Garde aussi les exemplaires normaux à enchanter pour les fusions dorées encore à
# faire.
# KEEP_FOR_GOLDEN_FUSIONS=true
# Anticipe les prochains Vortex, les essais d'ascension à venir et les évènements
# annoncés : garde les monnaies qui rapporteront plus plus tard (expérimental).
# HORIZON=false
# Actions que le plan ne propose jamais, séparées par des virgules : recycle,
# craft, enchant, fusion, constellation, invoke, ascension, evolution.
# SKIP_ACTIONS=
# Threads de calcul (plans calculés en parallèle) et calculs en attente au-delà
# desquels l'API répond 503.
# PLANNER_THREADS=2
# PLANNER_QUEUE_LIMIT=4
# Temps de recherche maximal par plan, en secondes (0 = illimité). Au-delà, la fin
# du plan est calculée en glouton : les réglages élevés ne bloquent plus le serveur.
# PLANNER_TIME_LIMIT_SECONDS=20

# --- Avancé ---------------------------------------------------------------------
# PORT=8080
# DRY_RUN=false
# RUN_ON_START=true
# CATALOG_TTL_MINUTES=10
# LOG_LEVEL=info

# --- Statistiques (Prometheus) --------------------------------------------------
# Métriques d'usage sur /metrics (joueurs distincts, demandes, pages vues…).
# METRICS=true
# Jeton exigé sur /metrics (Authorization: Bearer …), conseillé si le port est public.
# METRICS_TOKEN=
